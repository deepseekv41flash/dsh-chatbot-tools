{
  "name": "dsh-chatbot-tools",
  "version": "0.3.1",
  "description": "把 DeepSeek Chatbot 的能力带进 DeepSeek Harness：内容安全、联网/图片搜索、OCR、TTS、ASR、文档上传",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "client.js",
    "README.md",
    "README-en.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": [
    "deepseek",
    "dsh",
    "dsh-plugin",
    "harness",
    "chatbot",
    "safety-check",
    "web-search",
    "image-search",
    "ocr",
    "tts",
    "asr",
    "speech"
  ],
  "author": "deepseekv41flash",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseekv41flash/dsh-chatbot-tools.git"
  },
  "homepage": "https://github.com/deepseekv41flash/dsh-chatbot-tools#readme",
  "bugs": {
    "url": "https://github.com/deepseekv41flash/dsh-chatbot-tools/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "cordis": "*"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "test": "node test/safety-guard.test.mjs && node test/speakable.test.mjs && node test/files.test.mjs",
    "typecheck": "node --check lib/index.js"
  }
}
